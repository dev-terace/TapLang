// race condition 발생 가능성이 있으므로 partial unique index 추가
//
// MongoDB에서 직접 실행:
// db.Conversation.createIndex(
//   { directKey: 1 },
//   {
//     unique: true,
//     partialFilterExpression: {
//       directKey: { $type: "string" }
//     },
//     name: "Conversation_directKey_key"
//   }
// )



generator client {
  provider = "prisma-client-js"
  output   = "../../generated/mongo"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_DATABASE_URL")
}


model Conversation {
  id String @id @default(uuid()) @map("_id")

  type ConversationType

  // 1:1 중복 방지
  // 예: "2:9"
  // GROUP은 null
  directKey String?

  // 그룹명
  name String?

  description String? //CUSTOM 전용  
  password String? //CUSTOM 전용
  bans ConversationBan[]

  members ConversationMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
  messages Message[]
  lastMessageId String?
  lastMessageAt DateTime?

}


model ConversationBan {
  id String @id @default(uuid()) @map("_id")

  conversationId String
  userId Int

  bannedAt DateTime @default(now())
  bannedUntil DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@index([bannedUntil])
}


model ConversationMember {
  id String @id @default(uuid()) @map("_id")

  conversationId String

  userId Int

  role ConversationMemberRole @default(MEMBER)

  joinedAt DateTime @default(now())

  unreadCount Int @default(0)
  lastReadAt DateTime?

  conversation Conversation @relation(fields: [conversationId],references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}


enum ConversationMemberRole {
  OWNER
  MEMBER
}


model Message {
  id String @id @default(uuid()) @map("_id")

  conversationId String

  senderId Int

  content String

  attachments Json?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}


enum ConversationType {
  DIRECT
  GROUP
  CUSTOM
}