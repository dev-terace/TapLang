generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../../generated/postgres"
}

datasource db {
  provider = "postgresql"       
  url      = env("POSTGRES_DATABASE_URL") 
}


model Block {
  id Int @id @default(autoincrement())

  // 차단한 사람 (주체)
  blockerId Int
  blocker   MyProfile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  // 차단당한 사람 (대상)
  blockedId Int
  blocked   MyProfile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // 동일한 유저를 중복해서 차단할 수 없도록 고유 인덱스 설정
  @@unique([blockerId, blockedId])
}

model MyProfile {
  id         Int      @id @default(autoincrement())
  provider   String
  providerId String   @unique
  email      String   @unique
  name       String   @unique
  flag       String
  statusMsg  String?
  createdAt  DateTime @default(now())

  allowGroupInvite Boolean @default(true)
  showOnlineStatus Boolean @default(true)
  
  profileDetails     MyProfileDetails?

  chatSettings ChatSettings?

  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")

  friendshipsA Friends[] @relation("FriendA")
  friendshipsB Friends[] @relation("FriendB")

  blockedUsers Block[] @relation("Blocker") // 내가 차단한 유저 목록
  blockedBy    Block[] @relation("Blocked") // 나를 차단한 유저 목록
}


model MyProfileDetails {
  id                  Int       @id @default(autoincrement())
  
  profileId           Int       @unique
  profile             MyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  attendanceDays      Int       @default(0)
  aiTranslationCount  Int       @default(0)
  translationTagCount Int       @default(0)

  bio                 String?   @db.Text 

  spokenLangs         SpokenLanguage[]
  learningLangs       LearningLanguage[]
  snsLinks            SnsLink[]
}



model SpokenLanguage {
  id               Int              @id @default(autoincrement())
  language         String          
  
  profileDetailsId Int
  profileDetails   MyProfileDetails @relation(fields: [profileDetailsId], references: [id], onDelete: Cascade)
}


model LearningLanguage {
  id               Int              @id @default(autoincrement())
  language         String           
  
  profileDetailsId Int
  profileDetails   MyProfileDetails @relation(fields: [profileDetailsId], references: [id], onDelete: Cascade)
}


model SnsLink {
  id               Int              @id @default(autoincrement())
  platform         String          
  value            String           
  
  profileDetailsId Int
  profileDetails   MyProfileDetails @relation(fields: [profileDetailsId], references: [id], onDelete: Cascade)
}




model Friends {
  id Int @id @default(autoincrement())

  userAId Int
  userA MyProfile @relation("FriendA", fields: [userAId], references: [id])

  userBId Int
  userB MyProfile @relation("FriendB", fields: [userBId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
}

model FriendRequest {
  id Int @id @default(autoincrement())

  senderId Int
  sender MyProfile @relation("FriendRequestSender", fields: [senderId], references: [id])

  receiverId Int
  receiver MyProfile @relation("FriendRequestReceiver", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())

  @@unique([senderId, receiverId])
}


model ChatSettings {
  id Int @id @default(autoincrement())

  profileId Int @unique
  profile   MyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // 채팅 번역
  chatSourceLanguage String @default("ko")
  chatTargetLanguage String @default("en")

  // 메시지 번역
  messageTranslateLanguage String @default("ko")

  // 음성
  originalVoiceLanguage   String @default("auto")
  translatedVoiceLanguage String @default("ko")

  // 알림
  notificationEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}