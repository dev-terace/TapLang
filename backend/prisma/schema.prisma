generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"       
  url      = env("DATABASE_URL") 
}


model MyProfile {
  id         Int      @id @default(autoincrement())
  provider   String
  providerId String   @unique
  email      String   @unique
  name       String   @unique
  flag       String
  statusMsg  String?
  createdAt  DateTime @default(now())
  
    
  sentFriendships     Friends[] @relation("MyFriendRelation")
  receivedFriendships Friends[] @relation("FriendWithMeRelation")

  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
}

model Friends {
    id       Int       @id @default(autoincrement())
    ownId    Int
    own      MyProfile @relation("MyFriendRelation", fields: [ownId], references: [id])
    friendId Int
    friend   MyProfile @relation("FriendWithMeRelation", fields: [friendId], references: [id])
    @@unique([ownId, friendId])
    
}

model FriendRequest {
  id Int @id @default(autoincrement())

  senderId Int
  sender MyProfile @relation("FriendRequestSender", fields: [senderId], references: [id])

  receiverId Int
  receiver MyProfile @relation("FriendRequestReceiver", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())

  @@unique([senderId, receiverId])
}